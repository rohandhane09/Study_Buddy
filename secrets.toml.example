# Copy this file to .streamlit/secrets.toml for local development.
# Replace every placeholder with your own secret values.
# NEVER commit the real secrets.toml file to GitHub.
GROQ_API_KEY = "YOUR_GROQ_API_KEY"
OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"
SUPABASE_URL = "https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_KEY = "YOUR_SUPABASE_SERVER_SECRET_KEY"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
